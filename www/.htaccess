# Устанавливаем кодировку
AddDefaultCharset utf-8

# Запрещаем просмотр папок
Options +FollowSymLinks
Options -Indexes
DirectoryIndex index.php

# Включаем движок перезаписи
RewriteEngine On
RewriteBase /

# ===== 1. ПРАВИЛО ДЛЯ КОРЗИНЫ (САМОЕ ВАЖНОЕ, ДОЛЖНО БЫТЬ ПЕРВЫМ) =====
RewriteRule ^cart/addtocart/([0-9]+)/$ ?controller=cart&action=addtocart&id=$1 [QSA,L]

# ===== 2. УНИВЕРСАЛЬНЫЕ ПРАВИЛА =====
# /controller/action/id/
RewriteRule ^([a-z]+)/([a-z]+)/([0-9]+)/$ ?controller=$1&action=$2&id=$3 [QSA,L]

# /controller/action/
RewriteRule ^([a-z]+)/([a-z]+)/$ ?controller=$1&action=$2 [QSA,L]

# /controller/id/
RewriteRule ^([a-z]+)/([0-9]+)/$ ?controller=$1&id=$2 [QSA,L]

# ===== 3. ИЗОЛИРУЕМ РЕАЛЬНЫЕ ФАЙЛЫ =====
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d

# ===== 4. ВСЁ ОСТАЛЬНОЕ — НА INDEX.PHP =====
RewriteRule ^(.*)$ index.php [L,QSA]